# Copy to .env for local development. Never commit .env or real credentials.
DATABASE_URL=postgresql+psycopg://content_agent:change_me@db:5432/content_agent

# LLM Providers (Groq or OpenAI)
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# Search Providers (Tavily)
TAVILY_API_KEY=
SEARCH_API_KEY=

# AI Detector API (Optional: GPTZero / Sapling / Winston)
# If omitted, automatically uses the built-in Linguistic & Forensic AI Inspector via Groq
AI_DETECTOR_API_KEY=
GPTZERO_API_KEY=
SAPLING_API_KEY=
